PORT=3000
MONGODB_URI=mongodb://localhost:27017/mt-store
# Origin website Next.js (thư mục web/, cổng dev 3001). Nhiều origin cách nhau bằng dấu phẩy.
# Để trống thì phản chiếu mọi origin (tiện dev). Production nên ghi đúng domain web.
CORS_ORIGIN=http://localhost:3001
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback OAuth web, khớp từng ký tự với Authorized redirect URIs trên Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:3001/google/callback
# App Secret của app Meta, kiểm chữ ký webhook Page và data deletion. Không dùng để đăng nhập.
FACEBOOK_APP_SECRET=
# Username Page, dùng trong link m.me/{username}?ref={customerId}.
FACEBOOK_PAGE_USERNAME=
FACEBOOK_PAGE_ID=
# Page token dài hạn, gửi tin Messenger.
FACEBOOK_PAGE_ACCESS_TOKEN=
# Verify token tự chọn, dán vào webhook Page trên Meta.
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
