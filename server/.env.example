PORT=3000
MONGODB_URI=mongodb://localhost:27017/mt-store
# Origin website Next.js (thư mục web/, cổng dev 3001). Nhiều origin cách nhau bằng dấu phẩy.
# Để trống thì phản chiếu mọi origin (tiện dev). Production nên ghi đúng domain web.
CORS_ORIGIN=http://localhost:3001
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ZALO_APP_ID=
ZALO_APP_SECRET=
# Callback OAuth web, khớp từng ký tự với URL nền tảng Web trên Zalo Console.
ZALO_REDIRECT_URI=http://localhost:3001/zalo/callback
# API Key trong Quản lý Zalo App → Open APIs. Dùng để kiểm chữ ký webhook.
ZALO_API_KEY=
